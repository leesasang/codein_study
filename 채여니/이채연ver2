    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.linear_model import LinearRegression"
      ],
      "metadata": {
        "id": "5EYrG1AwouMS"
      },
      "execution_count": 1,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# 정상 데이터\n",
        "V = np.linspace(0, 5, 50)\n",
        "I_normal = 0.2 * V + np.random.normal(0, 0.01, 50)\n",
        "\n",
        "# 비정상 데이터 (기울기 낮고 노이즈 큼)\n",
        "I_fault = 0.05 * V + np.random.normal(0, 0.05, 50)\n",
        "\n",
        "# 데이터프레임 생성\n",
        "df_normal = pd.DataFrame({'V': V, 'I': I_normal, 'label': 'normal'})\n",
        "df_fault = pd.DataFrame({'V': V, 'I': I_fault, 'label': 'fault'})\n",
        "\n",
        "df = pd.concat([df_normal, df_fault])"
      ],
      "metadata": {
        "id": "MCQ5Jlizwal2"
      },
      "execution_count": 2,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "plt.figure(figsize=(6,4))\n",
        "\n",
        "for label in df['label'].unique():\n",
        "    subset = df[df['label']==label]\n",
        "    plt.plot(subset['V'], subset['I'], marker='o', label=label)\n",
        "\n",
        "plt.xlabel('Voltage (V)')\n",
        "plt.ylabel('Current (I)')\n",
        "plt.title('I-V Curve')\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "plt.show()\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
