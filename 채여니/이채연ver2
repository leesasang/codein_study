    {
      "cell_type": "code",
      "source": [
        "def extract_features(V, I):\n",
        "    X = V.reshape(-1,1)\n",
        "\n",
        "    model = LinearRegression()\n",
        "    model.fit(X, I)\n",
        "\n",
        "    slope = model.coef_[0]\n",
        "    r2 = model.score(X, I)\n",
        "    noise = np.std(I - model.predict(X))\n",
        "\n",
        "    return slope, r2, noise"
      ],
      "metadata": {
        "id": "kW7Uf7Fnwelq"
      },
      "execution_count": 4,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def classify(slope, r2, noise):\n",
        "    if slope < 0.1:\n",
        "        return \"비정상 (저항 증가)\"\n",
        "    elif r2 < 0.95:\n",
        "        return \"비정상 (비선형)\"\n",
        "    elif noise > 0.03:\n",
        "        return \"비정상 (노이즈 큼)\"\n",
        "    else:\n",
        "        return \"정상\""
      ],
      "metadata": {
        "id": "XM0efhhQwgE4"
      },
      "execution_count": 5,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "for label in df['label'].unique():\n",
        "    subset = df[df['label']==label]\n",
        "\n",
        "    V_data = subset['V'].values\n",
        "    I_data = subset['I'].values\n",
        "\n",
        "    slope, r2, noise = extract_features(V_data, I_data)\n",
        "    result = classify(slope, r2, noise)\n",
        "\n",
        "    print(f\"\\n[{label}]\")\n",
        "    print(f\"기울기: {slope:.4f}\")\n",
        "    print(f\"R^2: {r2:.4f}\")\n",
        "    print(f\"노이즈: {noise:.4f}\")\n",
        "    print(f\"판별 결과: {result}\")"
      ],
